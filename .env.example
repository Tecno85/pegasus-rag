# Create a free key at https://aistudio.google.com/app/apikey
# Keep billing disabled if you want the application to stop at the free quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Safe defaults for the public demonstration
MAX_UPLOAD_MB=10
MAX_UPLOAD_FILES=5
TOP_K=5
SIMILARITY_THRESHOLD=0.16

# Local embedding and chunking configuration
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=1100
CHUNK_OVERLAP=180

